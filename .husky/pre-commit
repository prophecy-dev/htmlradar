#!/usr/bin/env sh

# Secret scan when gitleaks is installed locally; CI runs it regardless.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact -v --config=.gitleaks.toml || {
    echo "❌ gitleaks found secrets in your staged changes. Commit blocked."
    exit 1
  }
fi

npx lint-staged
