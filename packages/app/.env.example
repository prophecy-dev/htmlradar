# HTMLRadar dashboard (packages/app) — Somnia-internal build on D1 + R2.
# Copy to packages/app/.env.local (or the repo-root .env.local) for `next dev`.
# In production set these on the htmlradar-app Worker (wrangler secret put). The D1 (DB) and R2
# (DOCS_BUCKET) bindings come from wrangler.jsonc, not from here.

# --- Sign-in: Privy (Google or e-mail code)-------------------------------------
# The Privy app. Its dashboard must allow this app's origin, have Google and e-mail login
# on, and "Return user data in an identity token" on (we read the e-mail there).
PRIVY_APP_ID=
# Comma-separated e-mail domains allowed in. Unset = somnia.foundation.
ALLOWED_EMAIL_DOMAINS=
# LOCAL DEVELOPMENT ONLY, and only while SESSION_SECRET is unset: acts as this
# user without signing in. Never set it in production.
ACCESS_INSECURE_DEV=
DEV_USER_EMAIL=

# --- Shared with the proxy worker -------------------------------------------
# Signs the dashboard session cookie and owner preview tokens ("Preview as
# you"); must equal the proxy's SESSION_SECRET. Without it nobody can sign in. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Build-time (NEXT_PUBLIC_*, baked into the bundle) ----------------------
# Origin the proxy serves recipient links on; links are {origin}/r/{slug}.
NEXT_PUBLIC_SHARE_ORIGIN=https://docs.hive.land
# 1 when the proxy can send verification codes (e-mail sending configured).
NEXT_PUBLIC_VERIFY_EMAIL_ENABLED=
