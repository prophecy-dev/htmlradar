# HTMLRadar dashboard (packages/app) — Somnia-internal build on D1 + R2.
# Copy to packages/app/.env.local (or the repo-root .env.local) for `next dev`.
# In production set these on the Cloudflare Pages project. The D1 (DB) and R2
# (DOCS_BUCKET) bindings come from wrangler.jsonc, not from here.

# --- Cloudflare Access (the only sign-in) -----------------------------------
# Team domain and the Access application's AUD tag. With both set, every
# request's Cf-Access-Jwt-Assertion is verified against the team's certs.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# Comma-separated e-mail domains allowed in (checked after Access). Empty = any
# address Access let through.
ALLOWED_EMAIL_DOMAINS=
# LOCAL DEVELOPMENT ONLY: acts as this user when no Access header is present
# and Access verification is not configured. Never set it in production.
ACCESS_INSECURE_DEV=
DEV_USER_EMAIL=

# --- Shared with the proxy worker -------------------------------------------
# Signs owner preview tokens ("Preview as you"); must equal the proxy's
# SESSION_SECRET. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Build-time (NEXT_PUBLIC_*, baked into the bundle) ----------------------
# Origin the proxy serves recipient links on; links are {origin}/r/{slug}.
NEXT_PUBLIC_SHARE_ORIGIN=https://docs.hive.land
# 1 when the proxy can send verification codes (e-mail sending configured).
NEXT_PUBLIC_VERIFY_EMAIL_ENABLED=
