{
  "name": "@htmlradar/app",
  "version": "0.1.0",
  "private": true,
  "description": "HTMLRadar web app — landing, auth, upload, share management, dashboard.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "copy:pdfjs": "node scripts/copy-pdfjs.mjs",
    "predev": "pnpm copy:pdfjs",
    "dev": "next dev --webpack -p 3000",
    "prebuild": "pnpm copy:pdfjs",
    "build": "next build --webpack",
    "start": "next start",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "pnpm build:cf && opennextjs-cloudflare preview",
    "deploy": "pnpm build:cf && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:pdf-browser": "pnpm copy:pdfjs && node scripts/test-pdf-to-deck-browser.mjs",
    "test:e2e": "playwright test",
    "qa:smoke": "playwright test e2e/smoke.spec.ts",
    "qa:journeys": "playwright test --project=golden",
    "qa:parity": "node scripts/golden-journeys.mjs",
    "gen:og": "node scripts/generate-og-card.mjs",
    "gen:email-cards": "node scripts/generate-onboarding-cards.mjs",
    "gen:cd-hero": "node scripts/generate-custom-domains-hero.mjs",
    "gen:email-preview": "node scripts/render-onboarding-email.mjs",
    "gen:llms": "node scripts/gen-llms-full.mjs"
  },
  "dependencies": {
    "@htmlradar/db": "workspace:*",
    "@privy-io/react-auth": "^3.44.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.0",
    "jose": "^6.2.12",
    "lenis": "^1.3.23",
    "lucide-react": "^1.14.0",
    "next": "^16.3.5",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@napi-rs/canvas": "1.0.9",
    "@opennextjs/cloudflare": "1.20.6",
    "@playwright/test": "^1.43.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.0",
    "dotenv": "^17.4.2",
    "fake-indexeddb": "6.2.4",
    "jsdom": "24.1.3",
    "pdf-lib": "1.17.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "wrangler": "^4.136.1"
  }
}
