// Cloudflare Worker config for the dashboard (Next.js via @opennextjs/cloudflare).
// Build and deploy from WSL/Linux/CI: `pnpm --filter @htmlradar/app deploy`.
//
// Sign-in is Privy, Google or e-mail code (see README); /api/v1/* uses API keys instead.
//
// Secrets and plain vars (`wrangler secret put`, or .dev.vars locally):
//   PRIVY_APP_ID           the Privy app used for e-mail login
//   ALLOWED_EMAIL_DOMAINS  e.g. somnia.foundation,hive.land (unset = somnia.foundation)
//   SESSION_SECRET         shared with the proxy: signs the session cookie and owner preview tokens
//   ACCESS_INSECURE_DEV,
//   DEV_USER_EMAIL         local development only, never in production
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "htmlradar-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "htmlradar",
      "database_id": "2efffb03-a481-4b53-b767-77689e5469a9",
      "migrations_dir": "../db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "DOCS_BUCKET",
      "bucket_name": "htmlradar-docs",
    },
  ],
}
