{
  "name": "@htmlradar/proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that serves /r/{slug} — lookup, gates, HTML injection, tracker endpoints.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "tracker": "pnpm --filter @htmlradar/tracker build && node scripts/tracker-bundle.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply htmlradar --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@htmlradar/db": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240314.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "wrangler": "^3.40.0"
  }
}
